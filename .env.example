# Copier en .env puis changer toutes les valeurs « change-moi ».
DB_NAME=parents_connectes
DB_USER=pc
DB_PASSWORD=change-moi
DB_ROOT_PASSWORD=change-moi-aussi

# Signature des JWT : au moins 32 caractères aléatoires (ex. `openssl rand -hex 32`).
JWT_SECRET=change-moi-avec-32-caracteres-minimum
# JWT_EXPIRES_IN=1h

# Client OAuth Google (vide = connexion Google désactivée, la route répond 503).
GOOGLE_CLIENT_ID=

# Compte administrateur créé (ou remis admin avec ce mot de passe) à chaque démarrage de l'API.
# Vide = aucun. Mot de passe : 8 caractères minimum, en choisir un long.
ADMINMAIL=
ADMINPASSWORD=

# Stockage des images (MinIO, API S3).
MINIO_ROOT_USER=pc-minio
MINIO_ROOT_PASSWORD=change-moi-encore
# MINIO_IMAGE=pgsty/minio:latest

# Origines autorisées en CORS, séparées par des virgules (vide en production = https://FRONT_HOST).
CORS_ORIGIN=

# Domaines publics (production, derrière Cloudflare Tunnel -> Traefik).
FRONT_HOST=parents-connectes.bryam.tech
API_HOST=api-parent-connectes.bryam.tech

# Proxys de confiance (production) : vide = valeur du compose (réseaux privés Docker).
# TRUST_PROXY=loopback,linklocal,uniquelocal
